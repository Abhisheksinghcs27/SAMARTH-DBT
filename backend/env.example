# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas)
# IMPORTANT: Replace <db_password> with your actual MongoDB Atlas password
# Make sure the database name "/samarth-dbt" is included in the connection string
MONGODB_URI=mongodb+srv://singhabhishek27:<db_password>@cluster0.32tjtdj.mongodb.net/samarth-dbt?retryWrites=true&w=majority

# JWT Secret (Change this in production!)
